# Server-side only: base URL of the Alquimia REST API (Railway deployment or local api/)
API_BASE_URL=http://localhost:3001

# Public site URL (used for canonical URLs, sitemap, JSON-LD)
PUBLIC_SITE_URL=http://localhost:4321

# WhatsApp number (E.164, no +) used to send cart orders
PUBLIC_WHATSAPP_NUMBER=573000000000

# Optional: hero video URL for the homepage (mp4/webm). Falls back to image if unset.
PUBLIC_HERO_VIDEO_URL=
# Optional: geo targeting meta tags (defaults: CO / Colombia). Set
# PUBLIC_GEO_POSITION to "lat;long" if the store has a physical location.
PUBLIC_GEO_REGION=CO
PUBLIC_GEO_PLACENAME=Colombia
PUBLIC_GEO_POSITION=

# Optional: comma-separated social profile URLs (emitted as Organization sameAs
# in JSON-LD), and Twitter/X handle for twitter:site.
PUBLIC_SOCIAL_URLS=
PUBLIC_TWITTER_HANDLE=
