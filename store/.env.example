# Server-side only: base URL of the Alquimia REST API (Railway deployment or local api/)
API_BASE_URL=http://localhost:3001

# Public site URL (used for canonical URLs, sitemap, JSON-LD)
PUBLIC_SITE_URL=http://localhost:4321

# WhatsApp number (E.164, no +) used to send cart orders
PUBLIC_WHATSAPP_NUMBER=573000000000

# Optional: hero video URL for the homepage (mp4/webm). Falls back to image if unset.
PUBLIC_HERO_VIDEO_URL=
