---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import ApiErrorNotice from '../../components/ApiErrorNotice.astro';
import AddToCart from '../../islands/AddToCart';
import ProductGallery from '../../islands/ProductGallery';
import { getProductBySlug, getRelatedProducts, ApiError } from '../../lib/api';
import { breadcrumbJsonLd, productJsonLd, type Crumb } from '../../lib/jsonld';
import { imageUrl, slugify, stripHtml } from '../../lib/format';
import type { Product } from '../../lib/types';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');
const { slug } = Astro.params;

let product: Product | null = null;
let related: Product[] = [];
let apiDown = false;

try {
  product = slug ? await getProductBySlug(slug) : null;
  if (product) related = await getRelatedProducts(product, 4);
} catch (err) {
  apiDown = err instanceof ApiError;
}

if (!product && !apiDown) {
  return Astro.rewrite('/404');
}

const crumbs: Crumb[] = product
  ? [
      { name: 'Inicio', href: '/' },
      ...(product.product_type
        ? [{ name: product.product_type, href: `/${slugify(product.product_type)}` }]
        : [{ name: 'Toda la tienda', href: '/shop' }]),
      { name: product.title, href: `/product/${product.handle}` },
    ]
  : [];

const description = product
  ? stripHtml(product.body_html) || `${product.title} — disponible en Alquimia.`
  : '';
const mainImage = product?.images[0] ?? null;
---

<BaseLayout
  title={product?.title ?? 'Producto'}
  description={description}
  canonical={product ? `/product/${product.handle}` : undefined}
  ogType="product"
  ogImage={imageUrl(mainImage)}
  jsonLd={product ? [breadcrumbJsonLd(siteUrl, crumbs), productJsonLd(siteUrl, product)] : []}
  cacheControl="public, max-age=0, s-maxage=600, stale-while-revalidate=1800"
>
  <div class="mx-auto w-[95%] px-gutter py-10">
    {product ? (
      <>
        <Breadcrumbs crumbs={crumbs} />

        <article class="mt-8 grid gap-12 lg:grid-cols-[3fr_2fr]">
          <ProductGallery
            client:idle
            images={product.images}
            variants={product.variants}
            title={product.title}
          />

          <div class="lg:sticky lg:top-28 lg:h-fit">
            {product.vendor && (
              <p class="text-xs tracking-widest text-stone uppercase">{product.vendor}</p>
            )}
            <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">{product.title}</h1>

            <div class="mt-8">
              <AddToCart client:idle product={product} />
            </div>

            {product.body_html && (
              <section class="mt-10 border-t border-sand pt-8" aria-labelledby="detalles">
                <h2 id="detalles" class="text-xs tracking-widest text-taupe uppercase">Detalles</h2>
                <div
                  class="prose-sm mt-4 max-w-none text-sm leading-relaxed text-taupe [&_a]:underline"
                  set:html={product.body_html}
                />
              </section>
            )}
          </div>
        </article>

        {related.length > 0 && (
          <section class="mt-24" aria-labelledby="relacionados">
            <h2 id="relacionados" class="font-serif text-2xl">También te puede gustar</h2>
            <div class="mt-8 grid grid-cols-2 gap-x-gutter gap-y-10 lg:grid-cols-4">
              {related.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <ApiErrorNotice />
    )}
  </div>
</BaseLayout>
