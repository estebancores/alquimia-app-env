---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import Pagination from '../components/Pagination.astro';
import ApiErrorNotice from '../components/ApiErrorNotice.astro';
import FilterBar from '../islands/FilterBar';
import { listingCanonical, loadListing, type ListingData } from '../lib/listing';
import { breadcrumbJsonLd, collectionPageJsonLd, itemListJsonLd } from '../lib/jsonld';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');

let listing: ListingData | null = null;
try {
  listing = await loadListing(Astro.url, undefined, { onSale: true });
} catch {
  listing = null;
}

const crumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Descuentos', href: '/sale' },
];

const page = listing?.state.page ?? 1;
const hasFilters = Boolean(
  listing && (listing.state.vendor || listing.state.priceKey || listing.state.search || listing.state.sort !== 'newest'),
);

const title = 'Descuentos';
---

<BaseLayout
  title={page > 1 ? `${title} — Página ${page}` : title}
  description="Productos en oferta en Alquimia: cuidado personal y belleza con descuento. Filtra por marca y precio."
  canonical={listingCanonical('/sale', page)}
  noindex={hasFilters}
  prevUrl={page > 1 ? listingCanonical('/sale', page - 1) : null}
  nextUrl={listing && page < listing.result.totalPages ? listingCanonical('/sale', page + 1) : null}
  jsonLd={
    listing
      ? [
          collectionPageJsonLd(siteUrl, { name: title, path: '/sale' }),
          breadcrumbJsonLd(siteUrl, crumbs),
          itemListJsonLd(siteUrl, listing.result.products, '/sale'),
        ]
      : []
  }
>
  <div class="mx-auto w-[95%] px-gutter py-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6 font-serif text-4xl sm:text-5xl">{title}</h1>

    {listing ? (
      <>
        <div class="sticky top-10.5 z-10 -mx-gutter mt-8 border-y border-sand bg-cream px-gutter py-3">
          <FilterBar
            client:visible
            meta={listing.meta}
            current={{
              vendor: listing.state.vendor,
              priceKey: listing.state.priceKey,
              sort: listing.state.sort,
            }}
            showProductType={false}
          />
        </div>

        <p class="mt-6 text-xs tracking-wide text-stone">
          {listing.result.pagination.total} productos
        </p>

        {listing.result.products.length ? (
          <div class="mt-6 grid grid-cols-2 gap-x-gutter gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            {listing.result.products.map((product, i) => (
              <ProductCard product={product} loading={i < 4 ? 'eager' : 'lazy'} />
            ))}
          </div>
        ) : (
          <p class="py-20 text-center text-taupe">No hay productos en oferta por ahora.</p>
        )}

        <Pagination
          page={page}
          totalPages={listing.result.totalPages}
          basePath="/sale"
          params={listing.paginationParams}
        />
      </>
    ) : (
      <ApiErrorNotice />
    )}
  </div>
</BaseLayout>
