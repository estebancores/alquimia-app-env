---
import type { ProductImage as ProductImageType } from '../lib/types';
import { imageUrl, responsiveImage } from '../lib/format';

interface Props {
  image: ProductImageType | null | undefined;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  alt,
  widths = [320, 480, 640, 960],
  sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw',
  loading = 'lazy',
  class: className = 'h-full w-full object-cover',
} = Astro.props;

// Plain <img> on purpose: astro:assets would route remote images through the
// server's /_image endpoint (download + sharp transform per request), which
// was the store's main memory sink. The CDN resizes instead.
const url = imageUrl(image);
const responsive = url ? responsiveImage(url, [...widths].sort((a, b) => a - b), image?.width) : null;
// The scraper stores intrinsic dimensions when available, otherwise fall back
// to a 4:5 editorial ratio (width/height attributes prevent layout shift).
const width = image?.width ?? 800;
const height = image?.height ?? 1000;
---

{responsive ? (
  <img
    src={responsive.src}
    srcset={responsive.srcset}
    sizes={responsive.srcset ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={className}
  />
) : (
  <div class={`flex items-center justify-center bg-bone text-stone ${className}`} role="img" aria-label={alt}>
    <span class="font-serif text-sm tracking-widest uppercase">Alquimia</span>
  </div>
)}
