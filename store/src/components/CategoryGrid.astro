---
import type { Category } from '../lib/types';
import ProductImage from './ProductImage.astro';

interface Props {
  categories: Category[];
  /** Compact horizontal strip (category page) vs editorial grid (homepage) */
  variant?: 'editorial' | 'strip';
  /** Slug of the selected category ('shop' = Todo en la tienda). */
  activeSlug?: string;
}

const { categories, variant = 'editorial', activeSlug } = Astro.props;

const stripItems = [
  {
    name: 'Todo en la tienda',
    slug: 'shop',
    href: '/shop',
    image: categories[0]?.image ?? null,
  },
  ...categories.map((cat) => ({
    name: cat.name,
    slug: cat.slug,
    href: `/${cat.slug}`,
    image: cat.image,
  })),
];
---

{variant === 'editorial' ? (
  <div class="grid grid-cols-2 gap-gutter md:grid-cols-4">
    {categories.map((cat) => (
      <a href={`/${cat.slug}`} class="group block" data-astro-prefetch="viewport">
        <div class="aspect-3/4 overflow-hidden bg-bone">
          <ProductImage
            image={cat.image}
            alt={cat.name}
            sizes="(min-width: 768px) 25vw, 50vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
        <p class="mt-3 text-center text-sm tracking-widest uppercase">{cat.name}</p>
      </a>
    ))}
  </div>
) : (
  <ul class="flex gap-5 overflow-x-auto pb-2">
    {stripItems.map((item) => {
      const active = item.slug === activeSlug;
      return (
        <li class="shrink-0">
          <a
            href={item.href}
            class="group block w-28 sm:w-36"
            data-astro-prefetch="viewport"
            aria-current={active ? 'page' : undefined}
          >
            <div class={`aspect-3/4 overflow-hidden bg-bone${active ? ' border-2 border-ink' : ''}`}>
              <ProductImage
                image={item.image}
                alt={item.name}
                sizes="144px"
                widths={[144, 288]}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
              />
            </div>
            <p class={`mt-2 text-center text-xs tracking-wide ${active ? 'font-bold text-ink' : 'text-taupe'} group-hover:text-ink`}>
              {item.name}
            </p>
          </a>
        </li>
      );
    })}
  </ul>
)}
