---
import type { Category } from '../lib/types';
import { localMediaFor } from '../lib/categoryMedia';
import CategoryMedia from './CategoryMedia.astro';

interface Props {
  categories: Category[];
  /** Compact horizontal strip (category page) vs editorial grid (homepage) */
  variant?: 'editorial' | 'strip';
  /** Slug of the selected category ('shop' = Todo en la tienda). */
  activeSlug?: string;
}

const { categories, variant = 'editorial', activeSlug } = Astro.props;

const stripItems = [
  {
    name: 'Todo en la tienda',
    slug: 'shop',
    href: '/shop',
    image: categories[0]?.image ?? null,
    media: localMediaFor('all'),
  },
  ...categories.map((cat) => ({
    name: cat.name,
    slug: cat.slug,
    href: `/${cat.slug}`,
    image: cat.image,
    media: localMediaFor(cat.slug),
  })),
];
---

{variant === 'editorial' ? (
  <div class="grid grid-cols-2 gap-gutter md:grid-cols-4">
    {categories.map((cat) => (
      <a href={`/${cat.slug}`} class="group block" data-astro-prefetch="hover">
        <div class="aspect-3/4 overflow-hidden bg-bone">
          <CategoryMedia
            media={localMediaFor(cat.slug)}
            image={cat.image}
            alt={cat.name}
            sizes="(min-width: 768px) 25vw, 50vw"
          />
        </div>
        <p class="mt-3 text-center text-sm tracking-widest uppercase">{cat.name}</p>
      </a>
    ))}
  </div>
) : (
  <ul class="flex gap-5 overflow-x-auto pb-2">
    {stripItems.map((item) => {
      const active = item.slug === activeSlug;
      return (
        <li class="shrink-0">
          <a
            href={item.href}
            class="group block w-32 sm:w-40"
            data-astro-prefetch="hover"
            aria-current={active ? 'page' : undefined}
          >
            <div class={`aspect-3/4 overflow-hidden border-2 bg-bone transition-all duration-200 group-hover:border-ink group-hover:p-0.5 ${active ? 'border-ink p-0.5' : 'border-transparent'}`}>
              <CategoryMedia
                media={item.media}
                image={item.image}
                alt={item.name}
                sizes="160px"
                widths={[160, 320]}
              />
            </div>
            <p class={`mt-2 text-center text-xs tracking-wide ${active ? 'font-bold text-ink' : 'text-taupe'} group-hover:text-ink`}>
              {item.name}
            </p>
          </a>
        </li>
      );
    })}
  </ul>
)}
