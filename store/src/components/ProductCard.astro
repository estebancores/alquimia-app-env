---
import type { Product } from '../lib/types';
import { formatPrice, minPriceVariant } from '../lib/format';
import ProductImage from './ProductImage.astro';

interface Props {
  product: Product;
  loading?: 'lazy' | 'eager';
}

const { product, loading = 'lazy' } = Astro.props;
const variant = minPriceVariant(product);
const image = product.images[0] ?? null;
const hoverImage = product.images[1] ?? null;
const compareAt = variant?.compare_at_price ? Number(variant.compare_at_price) : null;
const price = variant?.price ? Number(variant.price) : null;
const onSale = compareAt != null && price != null && compareAt > price;
---

<a href={`/product/${product.handle}`} class="group block" data-astro-prefetch="viewport">
  <div class="relative aspect-[4/5] overflow-hidden bg-bone">
    <ProductImage
      image={image}
      alt={image?.alt ?? product.title}
      loading={loading}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
    {hoverImage && (
      <div class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <ProductImage image={hoverImage} alt="" loading="lazy" />
      </div>
    )}
    {onSale && (
      <span class="absolute top-3 left-3 bg-ink px-2 py-1 text-[10px] tracking-widest text-cream uppercase">
        Oferta
      </span>
    )}
  </div>
  <div class="mt-3 space-y-1">
    <h3 class="text-sm leading-snug font-bold text-ink">{product.title}</h3>
    {price != null && (
      <p class="text-sm text-ink">
        {onSale && <s class="mr-2 text-ink">{formatPrice(compareAt)}</s>}
        <span class={onSale ? 'text-red-500' : undefined}>{formatPrice(price)}</span>
      </p>
    )}
  </div>
</a>
