---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-sand bg-bone">
  <div class="mx-auto grid w-[95%] gap-10 px-gutter py-14 sm:grid-cols-3">
    <div>
      <p class="font-serif text-xl tracking-widest uppercase">Alquimia</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-taupe">
        Cuidado personal y belleza, seleccionados con intención.
      </p>
    </div>
    <nav aria-label="Enlaces del sitio">
      <h2 class="text-xs font-medium tracking-widest text-stone uppercase">Tienda</h2>
      <ul class="mt-4 space-y-2 text-sm text-taupe">
        <li><a href="/shop" class="hover:text-ink">Todos los productos</a></li>
        <li><a href="/cart" class="hover:text-ink">Carrito</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="text-xs font-medium tracking-widest text-stone uppercase">Contacto</h2>
      <ul class="mt-4 space-y-2 text-sm text-taupe">
        <li>
          <a
            href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_NUMBER}`}
            rel="noopener"
            class="hover:text-ink"
          >
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-sand py-5 text-center text-xs text-stone">
    © {year} Alquimia. Todos los derechos reservados.
  </div>
</footer>
